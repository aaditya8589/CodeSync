# Copy to deploy/.env and fill in. Never commit .env.
DOMAIN=codesync-yourname.duckdns.org
DB_PASSWORD=change-me
# At least 32 characters: openssl rand -base64 48
JWT_SECRET=change-me
EXECUTION_MAX_CONCURRENT=4
# Optional: "Sign in with Google". OAuth client id from console.cloud.google.com (see deploy/README.md)
GOOGLE_CLIENT_ID=
